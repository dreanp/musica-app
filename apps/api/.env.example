# --- Storage ---
# "s3" = Cloudflare R2 (ou Garage/SeaweedFS no futuro). "local" = pasta no disco (só para desenvolvimento).
STORAGE_DRIVER=s3

# Cloudflare R2 (Painel > R2 > Manage R2 API Tokens)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=musica
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Só para STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data
# URL em que esta API é acessada (no modo local, use o IP do PC na rede para testar no iPhone)
PUBLIC_API_URL=http://localhost:3000

# --- API ---
PORT=3000
# Domínios do frontend separados por vírgula (ou * no protótipo)
CORS_ORIGIN=*
# Senha simples do protótipo (até o login da Fase 3). Vazio = sem proteção.
PROTO_TOKEN=
# Validade das URLs assinadas dos segmentos, em segundos (6 h)
SIGNED_URL_TTL=21600
